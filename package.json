{
  "name": "pet-project",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.9",
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@types/bun": "latest",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start:dev": "turbo run start:dev",
    "generate": "turbo run generate --filter=web",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "deploy:production": "bash scripts/deploy.sh"
  }
}
