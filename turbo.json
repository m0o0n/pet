{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "start:dev": {
      "dependsOn": ["generate", "api#generate:prisma"],
      "cache": false,
      "persistent": true
    },
    "generate:prisma": {
      "outputs": ["prisma/generated/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "generate:spec": {
      "outputs": ["generated/openapi.json"]
    },
    "generate": {
      "dependsOn": ["api#generate:prisma", "api#generate:spec"],
      "outputs": ["src/generated/**"]
    }
  }
}
