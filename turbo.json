{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**"
      ]
    },
    "start:dev": {
      "dependsOn": ["generate"],
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "generate:spec": {
      "outputs": [
        "generated/openapi.json"
      ]
    },
    "generate": {
      "dependsOn": [
        "api#generate:spec"
      ],
      "outputs": [
        "src/generated/**"
      ]
    }
  }
}